# LLM Provider Configuration
# Supported providers: "openai", "anthropic", "google", "ollama", "mock"
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o
LLM_TEMPERATURE=0.0

# API Keys (Set whichever provider you are using)
OPENAI_API_KEY=your-openai-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key
GOOGLE_API_KEY=your-google-api-key

# Ollama / Local Models (Optional)
OLLAMA_BASE_URL=http://localhost:11434

# Workspaces & Storage
WORKSPACE_ROOT=./workspace
REPOSITORIES_DIR=./workspace/repositories
SANDBOX_DIR=./workspace/sandboxes
KNOWLEDGE_BASE_DIR=./knowledge_base

# LangSmith Observability
LANGCHAIN_TRACING_V2=false
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=your-langsmith-api-key
LANGCHAIN_PROJECT=ai-software-engineering-agent

# Application Security
COMMAND_TIMEOUT_SECONDS=60
MAX_SEARCH_RESULTS=50
MAX_FILE_READ_LINES=500
